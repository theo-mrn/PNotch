    },
    "%@ caught your copy!" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a attrapé votre copie !"
          }
        }
      }
    },
    "%@ dozed off while you were away." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s’est assoupi pendant votre absence."
          }
        }
      }
    },
    "%@ is dancing to “%@”." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ danse sur « %@ »."
          }
        }
      }
    },
    "%@ is dancing." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ danse."
