    },
    "%@ is overheating: CPU at %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ surchauffe : processeur à %@."
          }
        }
      }
    },
    "%@ is overheating: the Mac is running hot." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ surchauffe : le Mac chauffe."
          }
        }
      }
    },
    "%@ is plugged in!" : {
      "comment" : "A message that is announced when a module is plugged in.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branché : %@ !"
