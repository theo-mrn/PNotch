      }
    },
    "%@ left" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore %@"
          }
        }
      }
    },
    "%@ likes this song." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aime ce morceau."
          }
        }
      }
    },
    "%@ loves that." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adore ça."
          }
        }
      }
    },
    "%@ of %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sur %@"
          }
        }
      }
    },
    "%@ plugged it in!" : {
      "comment" : "A line of text that Pixel might display. The argument is the name of Pixel.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ l’a branché !"
          }
        }
      }
    },
    "%@ reacts to what you do everywhere: it dances to your music and catches your copies. In the Atelier, it presents the modules you can plug in. Right-click it to pet it; its looks are behind the paintbrush." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ réagit à ce que vous faites, partout : il danse sur votre musique et attrape vos copies. Dans l’Atelier, il présente les modules à brancher. Clic droit dessus pour le caresser ; son apparence se règle derrière le pinceau."
          }
        }
      }
    },
    "%@, %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@"
          }
        }
      }
    },
